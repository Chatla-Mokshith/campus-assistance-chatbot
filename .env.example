# ==============================================================================
# CAMPUS ASSISTANCE CHATBOT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual database credentials.
# ==============================================================================

# MySQL Database Configuration (Local or Cloud host like TiDB / Aiven / Railway)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=campus_assistance

# SSL Configuration (Set DB_SSL=true for cloud MySQL providers like TiDB Serverless / Aiven)
DB_SSL=false

# Optional: Alternative single connection string (Used by Railway / Render if provided)
# DATABASE_URL=mysql://user:password@host:port/database_name

# Google Gemini API Key (Free tier from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Session Secret Key (Generate random 32-byte hex string)
SECRET_KEY=your_random_flask_secret_key_here

# Admin Dashboard Default Account
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here

